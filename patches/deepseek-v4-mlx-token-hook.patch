@@ -86,6 +86,14 @@ class Model(nn.Module):
 
     def __call__(self, input_ids: mx.array, last_logit_only: bool = False,
                  cache=None) -> mx.array:
+        # Optional decode-time hook (set externally, e.g. streaming pre-gated
+        # prefetch): fires with the token id before any compute, so hash-routed
+        # layers' experts — a pure tid2eid lookup — can be fetched while the
+        # embedding and early attention run. Inert when unset; never fires for
+        # multi-token (prefill) steps.
+        hook = getattr(self, "token_hook", None)
+        if hook is not None and input_ids.shape[1] == 1:
+            hook(input_ids)
         h = self.embed(input_ids)
         # the four Hyper-Connection streams start as identical copies
         h = mx.broadcast_to(h[:, :, None, :], (*h.shape[:2], self.hc_mult, h.shape[-1]))
